generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String     @id @default(uuid())
  usuario   String     @unique
  email     String     @unique
  password  String
  nombre    String
  apellido  String
  rol       RolUsuario @default(OPERARIO)
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("usuarios")
}

enum RolUsuario {
  ADMIN
  CONTADOR
  OPERARIO
  VISOR
}

model Cliente {
  id        String   @id @default(uuid())
  nombre    String
  cuit      String?
  telefono  String?
  email     String?
  contacto  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rutas  Ruta[]
  viajes Viaje[]

  @@map("clientes")
}

model Ruta {
  id           String   @id @default(uuid())
  clienteId    String
  cliente      Cliente  @relation(fields: [clienteId], references: [id])
  origen       String
  destino      String
  tipoCarga    String?
  tarifaSinIVA Float
  comision     Float    @default(0)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  viajes Viaje[]

  @@map("rutas")
}

model Comisionista {
  id        String   @id @default(uuid())
  nombre    String
  cuit      String?
  telefono  String?
  email     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fleteros      Fletero[]
  viajes        Viaje[]
  pagosComision PagoComision[]

  @@map("comisionistas")
}

enum FormaPago {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
}

model Fletero {
  id             String        @id @default(uuid())
  nombre         String
  cuit           String?
  telefono       String?
  email          String?
  formaPago      FormaPago     @default(TRANSFERENCIA)
  plazo          Int           @default(30)
  comisionistaId String?
  comisionista   Comisionista? @relation(fields: [comisionistaId], references: [id])
  activo         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  viajes      Viaje[]
  ordenesPago OrdenPago[]

  @@map("fleteros")
}

enum EstadoViaje {
  PENDIENTE
  EN_CURSO
  COMPLETADO
  CANCELADO
}

enum EstadoPago {
  PENDIENTE
  PAGADO
}

enum TipoIVA {
  IVA_21
  IVA_10_5
  EXENTO
}

model Viaje {
  id             String        @id @default(uuid())
  fecha          DateTime
  clienteId      String
  cliente        Cliente       @relation(fields: [clienteId], references: [id])
  rutaId         String?
  ruta           Ruta?         @relation(fields: [rutaId], references: [id])
  origen         String
  destino        String
  tipoCarga      String?
  cantCarga      Float?
  tarifaSinIVA   Float?
  tipoIVA        TipoIVA       @default(EXENTO)
  valorIVA       Float?        @default(0)
  valorViaje     Float?
  totalViaje     Float?
  comision       Float?        @default(0)
  comisionistaId String?
  comisionista   Comisionista? @relation(fields: [comisionistaId], references: [id])
  fleteroId      String?
  fletero        Fletero?      @relation(fields: [fleteroId], references: [id])
  remito         String?
  fcNro          String?
  fechaRecepcion DateTime?
  estadoViaje    EstadoViaje   @default(PENDIENTE)
  estadoPago     EstadoPago    @default(PENDIENTE)
  ordenPagoId    String?
  ordenPago      OrdenPago?    @relation(fields: [ordenPagoId], references: [id])
  observaciones  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("viajes")
}

model OrdenPago {
  id        String    @id @default(uuid())
  numero    Int       @default(autoincrement())
  fecha     DateTime  @default(now())
  fleteroId String
  fletero   Fletero   @relation(fields: [fleteroId], references: [id])
  total     Float     @default(0)
  estado    String    @default("PENDIENTE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  viajes       Viaje[]
  valores      ValorOP[]
  comprobantes ComprobanteOP[]

  @@map("ordenes_pago")
}

model ValorOP {
  id          String    @id @default(uuid())
  ordenPagoId String
  ordenPago   OrdenPago @relation(fields: [ordenPagoId], references: [id], onDelete: Cascade)
  tipo        String
  monto       Float
  chequeBanco String?
  chequeNro   String?
  chequeFecha DateTime?
  createdAt   DateTime  @default(now())

  @@map("valores_op")
}

model ComprobanteOP {
  id          String    @id @default(uuid())
  ordenPagoId String
  ordenPago   OrdenPago @relation(fields: [ordenPagoId], references: [id], onDelete: Cascade)
  tipo        String
  numero      String
  monto       Float
  fecha       DateTime?
  createdAt   DateTime  @default(now())

  @@map("comprobantes_op")
}

model PagoComision {
  id             String       @id @default(uuid())
  comisionistaId String
  comisionista   Comisionista @relation(fields: [comisionistaId], references: [id])
  fecha          DateTime     @default(now())
  monto          Float
  concepto       String?
  createdAt      DateTime     @default(now())

  @@map("pagos_comision")
}
